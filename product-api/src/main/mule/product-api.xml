<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- HTTP Listener Configuration -->
    <http:listener-config
        name="HTTP_Listener_config"
        doc:name="HTTP Listener config"
        doc:id="846404ed-5fb3-4247-b9c7-5f9aa218b512">

        <http:listener-connection
            host="0.0.0.0"
            port="8081"/>

    </http:listener-config>


    <!-- Database Configuration -->
    <db:config
        name="Database_Config"
        doc:name="Database Config"
        doc:id="e0637e5f-99b6-4912-a929-a72477e5102e">

        <db:my-sql-connection
            host="localhost"
            port="3306"
            user="root"
            password="Mysql@007"
            database="order_management_db"/>

    </db:config>


    <!-- Product API Flow -->
    <flow
        name="product-apiFlow"
        doc:id="c3530ccb-364f-474e-8201-4f574d78188c">

        <!-- HTTP Listener -->
        <http:listener
            doc:name="Listener"
            doc:id="cf3e7457-22ee-4b5b-9b48-fd4d656eee42"
            path="/products/{productId}"
            config-ref="HTTP_Listener_config">

            <!-- IMPORTANT: This controls the actual HTTP status code -->
            <http:response
                statusCode="#[vars.httpStatus default 200]"/>

        </http:listener>


        <!-- Database Query -->
        <db:select
            doc:name="Select"
            doc:id="d72aa4e6-3a30-42f9-801e-c32cb52e94b8"
            config-ref="Database_Config">

            <db:sql><![CDATA[
SELECT productId, name, price, stock
FROM products
WHERE productId = :productId
            ]]></db:sql>

            <db:input-parameters><![CDATA[
#[{
    productId: attributes.uriParams.productId
}]
            ]]></db:input-parameters>

        </db:select>


        <!-- Set HTTP Status -->
        <set-variable
            value="#[if (isEmpty(payload)) 404 else 200]"
            doc:name="Set Variable"
            doc:id="ce1335fe-1eca-4205-93a6-dfc3a6519c7e"
            variableName="httpStatus"/>


        <!-- Response Transformation -->
        <ee:transform
            doc:name="Transform Message"
            doc:id="4894b8d4-bfe8-4739-9aaf-44cdf25f763a">

            <ee:message>

                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
if (isEmpty(payload))
    {
        status: 404,
        message: "Product not found"
    }
else
    {
        productId: payload[0].productId,
        name: payload[0].name,
        price: payload[0].price,
        stock: payload[0].stock
    }
                ]]></ee:set-payload>

            </ee:message>

        </ee:transform>

    </flow>

</mule>